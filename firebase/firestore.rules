rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /budgetListCollection/{document} {
      allow create: if request.resource.data.userForeignKEY == /databases/$(database)/documents/userCollection/$(request.auth.uid);
      allow read: if resource.data.userForeignKEY == /databases/$(database)/documents/userCollection/$(request.auth.uid);
      allow write: if resource.data.userForeignKEY == /databases/$(database)/documents/userCollection/$(request.auth.uid);
      allow delete: if resource.data.userForeignKEY == /databases/$(database)/documents/userCollection/$(request.auth.uid);
    }

    match /profileCollection/{document} {
      allow create: if request.resource.data.userForeignKEY == /databases/$(database)/documents/userCollection/$(request.auth.uid);
      allow read: if resource.data.userForeignKEY == /databases/$(database)/documents/userCollection/$(request.auth.uid);
      allow write: if resource.data.userForeignKEY == /databases/$(database)/documents/userCollection/$(request.auth.uid);
      allow delete: if resource.data.userForeignKEY == /databases/$(database)/documents/userCollection/$(request.auth.uid);
    }

    match /userCollection/{document} {
      allow create: if request.auth.uid == request.resource.data.uid;
      allow read: if request.auth.uid == resource.data.uid;
      allow write: if request.auth.uid == resource.data.uid;
      allow delete: if request.auth.uid == resource.data.uid;
    }

    match /folderCreateCollection/{document} {
      allow create: if request.resource.data.userForeignKEY == /databases/$(database)/documents/userCollection/$(request.auth.uid);
      allow read: if resource.data.userForeignKEY == /databases/$(database)/documents/userCollection/$(request.auth.uid);
      allow write: if resource.data.userForeignKEY == /databases/$(database)/documents/userCollection/$(request.auth.uid);
      allow delete: if resource.data.userForeignKEY == /databases/$(database)/documents/userCollection/$(request.auth.uid);
    }

    match /pieChartCollection/{document} {
      allow create: if request.resource.data.userForeignKEY == /databases/$(database)/documents/userCollection/$(request.auth.uid);
      allow read: if resource.data.userForeignKEY == /databases/$(database)/documents/userCollection/$(request.auth.uid);
      allow write: if resource.data.userForeignKEY == /databases/$(database)/documents/userCollection/$(request.auth.uid);
      allow delete: if resource.data.userForeignKEY == /databases/$(database)/documents/userCollection/$(request.auth.uid);
    }

    match /notifyActionCollection/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }
  }
}
